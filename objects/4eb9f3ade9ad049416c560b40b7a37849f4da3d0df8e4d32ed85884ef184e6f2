import difflib,hashlib,json,math,pathlib,sys
import torch
from safetensors import safe_open
from transformers import AutoTokenizer
ROOT=pathlib.Path(__file__).resolve().parent
def read(p):return json.loads(p.read_text())
def digest(p):
    h=hashlib.sha256()
    with p.open('rb') as f:
        for x in iter(lambda:f.read(8*1024*1024),b''):h.update(x)
    return h.hexdigest()
def thash(t):return hashlib.sha256(t.contiguous().view(torch.uint8).numpy().tobytes()).hexdigest()
RESULT=pathlib.Path(read(ROOT/'audit/evaluation_target.json')['result'])
result=read(RESULT)
assert result['status']=='completed' and result['generation_mode']=='beam-search'
assert result['evaluated_blocks']==[1,2,3,4] and result['skipped_blocks']==[0]
assert result['stage_restoration']=='historical_stage_state'
assert set(result['all_block_results'])=={f'block_{b}' for b in range(1,5)}
manifest=read(ROOT/'run_manifest.json')
assert manifest['attention_share']==0.3023255813953488 and manifest['mlp_share']==0.6976744186046512
assert manifest['reselect_optimizer_steps']==100
assert manifest['total_LoRA_AB_budget']==1.0 and manifest['actual_initial_learning_rate']==1e-4
for name,h in manifest['code_sha256'].items():assert digest(ROOT/name)==h,name
baseline=ROOT/'official_baseline';code=ROOT/'eval_code'
for name in ['collator.py','continual_data_v2.py','continual_lora.py','evaluate.py','prompt.py','utils.py']:
    assert (baseline/name).read_bytes()==(code/name).read_bytes()
patch=''.join(difflib.unified_diff((baseline/'continual_test.py').read_text().splitlines(keepends=True),(code/'continual_test.py').read_text().splitlines(keepends=True),fromfile='official/continual_test.py',tofile='eval_code/continual_test.py'))
patch+=''.join(difflib.unified_diff([],(code/'evaluation_audit.py').read_text().splitlines(keepends=True),fromfile='/dev/null',tofile='eval_code/evaluation_audit.py'))
assert patch==(ROOT/'official_evaluation.patch').read_text()
frozen={}
with safe_open(str(ROOT/'ckpt/block_0/model.safetensors'),framework='pt',device='cpu') as f:
    for k in f.keys():
        if k.endswith('.A') or k.endswith('.B') or '.A_matrices.' in k or '.B_matrices.' in k or '.modules_to_save.default.' in k:continue
        frozen[k]=thash(f.get_tensor(k))
stage_reports=[]
final_tokenizer=AutoTokenizer.from_pretrained(ROOT/'evaluation_checkpoints')
with safe_open(str(ROOT/'ckpt/block_4/model.safetensors'),framework='pt',device='cpu') as final:
    for b in range(1,5):
        stage=ROOT/'ckpt'/f'block_{b}'
        stage_tokenizer=AutoTokenizer.from_pretrained(stage)
        assert stage_tokenizer.get_vocab()==final_tokenizer.get_vocab()
        for name,h in read(stage/'stage_manifest.json')['files'].items():assert digest(stage/name)==h
        assert read(stage/'launch_config.json')['experiment_args']['reselect_steps']==100
        selected=read(stage/'selected_layers.json')
        assert len(selected['matrix_selected'])==112 and selected['actual_selected_lora_AB_parameters']==5636096
        state=read(stage/'trainer_state.json')
        val=[x['eval_loss'] for x in state['log_history'] if 'eval_loss' in x]
        assert len(val)==4 and state['best_metric']==min(val)
        assert read(stage/'model_only_best_reload.json')['best_metric']==min(val)
        assert read(stage/'launch_config.json')['training_arguments']['num_train_epochs']==4
        assert read(stage/'launch_config.json')['original_train_length']==read(stage/'launch_config.json')['actual_train_length']
        coverage=read(ROOT/'audit'/f'coverage_block{b}.json')
        assert coverage['exactly_once'] and coverage['eligible_users']==coverage['evaluated_users']==coverage['unique_users']
        assert coverage['eligible_users']==read(ROOT/'audit/asset_compatibility.json')['user_counts'][str(b)]['eligible_users']
        assert read(ROOT/'audit'/f'stage_{b}_restoration.json')['all_saved_stage_tensors_exact']
        actual=result['all_block_results'][f'block_{b}']['all_prompt_results'][0]
        assert all(math.isfinite(v) and 0<=v<=1 for v in actual.values())
        checked_frozen=[];checked_snapshots=[]
        with safe_open(str(stage/'model.safetensors'),framework='pt',device='cpu') as saved:
            for k,h in frozen.items():
                assert thash(saved.get_tensor(k))==h,(b,k)
                checked_frozen.append(k)
            for k in saved.keys():
                if k.endswith('.A') or k.endswith('.B'):
                    assert torch.equal(saved.get_tensor(k),final.get_tensor(k+'_matrices.'+str(b))),(b,k)
                    checked_snapshots.append(k)
        assert len(checked_snapshots)==224
        for rank in [0,1]:
            opt=read(ROOT/'audit'/f'optimizer_block{b}_rank{rank}.json')
            assert not opt['backbone_trainable'] and all(x['initial_lr']==1e-4 for x in opt['parameter_groups'])
        stage_reports.append(dict(block=b,validation_losses=val,best_validation_loss=min(val),
               stage_tokenizer_matches_effective_evaluation_vocabulary=True,vocab_size=len(stage_tokenizer),
               frozen_backbone_tensors_unchanged=checked_frozen,final_history_matches_complete_stage_AB=checked_snapshots,
               evaluated_users=coverage['evaluated_users'],unique_users=coverage['unique_users']))
for metric,value in result['macro_average'].items():
    expected=sum(result['all_block_results'][f'block_{b}']['all_prompt_results'][0][metric] for b in range(1,5))/4
    assert value==expected
report=dict(passed=True,generation_mode='beam-search',evaluated_blocks=[1,2,3,4],skipped_blocks=[0],
            stage_restoration='historical_stage_state',stages=stage_reports,
            code_fingerprints_unchanged=True,official_diff_complete=True,macro_uses_unrounded_equal_block_weights=True,
            result_sha256=digest(RESULT))
(ROOT/'audit/final_verification.json').write_text(json.dumps(report,indent=2))
print(json.dumps(dict(passed=True,stages=4,coverage=[r['evaluated_users'] for r in stage_reports],macro=result['macro_average'])))
