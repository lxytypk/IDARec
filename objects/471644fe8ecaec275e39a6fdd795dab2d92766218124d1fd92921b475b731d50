import hashlib,importlib.metadata,json,os,pathlib,shutil,subprocess,sys
from safetensors import safe_open
from transformers import AutoTokenizer,AutoConfig
ROOT=pathlib.Path(__file__).resolve().parent
sys.path.insert(0,str(ROOT/'train_code'))
from utils import parse_global_args,parse_dataset_args,parse_train_args,set_seed
from continual_data_v2 import ContinualSeqRecDataset_v2
import argparse

def digest(p):
    h=hashlib.sha256()
    with pathlib.Path(p).open('rb') as f:
        for x in iter(lambda:f.read(8*1024*1024),b''):h.update(x)
    return h.hexdigest()
def main():
    p=parse_train_args(parse_dataset_args(parse_global_args(argparse.ArgumentParser())))
    a=p.parse_args(['--dataset','Books_cl_ori','--data_path',str(ROOT/'datasets'),'--index_file','.index.epoch20000_edim32_beta0.0.json'])
    set_seed(42)
    b0=ROOT/'ckpt/block_0';base=ROOT/'inputs/base_model'
    tok=AutoTokenizer.from_pretrained(base);tok.pad_token_id=0
    data=ContinualSeqRecDataset_v2(a,mode='train',current_block=0,num_blocks=5)
    tok.add_tokens(data.get_new_tokens());old=AutoTokenizer.from_pretrained(b0)
    assert tok.get_vocab()==old.get_vocab() and len(tok)==129280
    configs=[AutoConfig.from_pretrained(x).to_dict() for x in [base,b0]]
    fields=['hidden_size','intermediate_size','num_hidden_layers','num_attention_heads','num_key_value_heads','head_dim','rope_scaling','rope_theta','model_type']
    assert all(configs[0][k]==configs[1][k] for k in fields)
    with safe_open(str(b0/'model.safetensors'),framework='pt',device='cpu') as f:
        keys=list(f.keys());ab=[k for k in keys if k.endswith('.A') or k.endswith('.B')]
        assert len(ab)==224
        import torch
        for k in ab:
            assert torch.equal(f.get_tensor(k),f.get_tensor(k[:-1]+k[-1]+'_matrices.0'))
        for k in ['lm_head.modules_to_save.default.weight','model.embed_tokens.modules_to_save.default.weight']:
            assert f.get_slice(k).get_shape()==[129280,2048]
    provenance=json.loads((ROOT/'block0_provenance.json').read_text())
    assert digest(b0/'model.safetensors')==provenance['shared_model_SHA256']
    for name,expected in provenance['data_sha256'].items():
        assert digest(ROOT/'datasets/Books_cl_ori'/name)==expected,name
    files={str(p):dict(bytes=p.stat().st_size,sha256=digest(p)) for p in (ROOT/'datasets/Books_cl_ori').iterdir() if p.is_file()}
    for directory in [base,b0]:
        for p in directory.iterdir():
            if p.is_file():files[str(p)]=dict(bytes=p.stat().st_size,sha256=digest(p))
    counts={}
    for b in range(1,5):
        d=ContinualSeqRecDataset_v2(a,mode='test',current_block=b,num_blocks=5)
        raw=d.block_data[b];eligible=[str(u) for u,v in raw.items() if len(v['current_block'])>=3]
        assert len(d)==len(eligible)==len(set(eligible))
        for rows in d.block_data.values():
            for row in rows.values():
                for item in row['previous_block']+row['current_block']:assert str(item) in d.indices
        counts[b]=dict(original_users=len(raw),eligible_users=len(d))
    inv=subprocess.check_output(['nvidia-smi','--query-gpu=index,uuid,name,memory.used,utilization.gpu','--format=csv,noheader,nounits'],text=True)
    apps=subprocess.check_output(['nvidia-smi','--query-compute-apps=gpu_uuid,pid,used_memory','--format=csv,noheader,nounits'],text=True)
    selected=[row.split(',') for row in inv.splitlines() if int(row.split(',')[0]) in [2, 3]]
    assert len(selected)==2 and all(int(row[3])<=64 and int(row[4])==0 for row in selected)
    assert not any(row[1].strip() in apps for row in selected)
    remaining=sum(not (ROOT/'ckpt'/f'block_{b}'/'stage_manifest.json').is_file() for b in range(1,5))
    needed=22*1024**3 if remaining else 4*1024**3
    assert shutil.disk_usage(ROOT).free>needed, f'Insufficient persistent room: {needed} bytes required'

    result=dict(status='passed',dataset='Books_cl_ori',data_path=str((ROOT/'datasets/Books_cl_ori').resolve()),shared_block0=str(b0.resolve()),base_model=str(base),
        base_block0_model_fields_match=fields,tokenizer_mapping_exact=True,vocabulary_size=len(tok),special_tokens=tok.special_tokens_map,
        user_counts=counts,files=files,gpu_inventory=inv,gpu_processes=apps,selected_gpus=[2, 3],
        versions={n:importlib.metadata.version(n) for n in ['torch','transformers','peft','accelerate','deepspeed','flash-attn','safetensors','numpy','datasets','pandas','pyarrow']},python=sys.version,
        estimated_disk_GiB=dict(additional_persistent_peak_at_recovery=21,search_additional_reserve=0,temporary_shm_peak=16),CUDA_LAUNCH_BLOCKING=os.environ.get('CUDA_LAUNCH_BLOCKING'))
    result.update(seed=42,probe_seed=42,lora_full_parameters=5636096,total_budget=1127219,family_budget={'attention':450887,'mlp':676332})
    (ROOT/'audit/preflight.json').write_text(json.dumps(result,indent=2))
    (ROOT/'audit/asset_compatibility.json').write_text(json.dumps(result,indent=2));print(json.dumps(result,indent=2))
if __name__=='__main__':main()
