import datetime,fcntl,hashlib,importlib.metadata,json,os,pathlib,shlex,shutil,socket,subprocess,sys,traceback
ROOT=pathlib.Path(__file__).resolve().parent
PYTHON=sys.executable
SELECTED_UUIDS=set()
def stamp():return datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=8))).strftime('%Y%m%d_%H%M%S')
def read(p):return json.loads(pathlib.Path(p).read_text())
def write(p,v):
    p=pathlib.Path(p);p.parent.mkdir(parents=True,exist_ok=True)
    tmp=p.with_name(p.name+'.tmp');tmp.write_text(json.dumps(v,indent=2,ensure_ascii=False));tmp.replace(p)
def digest(p):
    h=hashlib.sha256()
    with p.open('rb') as f:
        for x in iter(lambda:f.read(8*1024*1024),b''):h.update(x)
    return h.hexdigest()
def phase(name,cmd,cwd,env):
    if name!='environment' and name!='gradient_identity':
        active=subprocess.check_output(['nvidia-smi','--query-compute-apps=gpu_uuid,pid,process_name,used_memory','--format=csv,noheader,nounits'],text=True)
        assert not any(line.split(',')[0].strip() in SELECTED_UUIDS for line in active.splitlines()),f'Selected GPU occupied before {name}: {active}'
    log=ROOT/'logs'/f'{name}_{stamp()}.log'
    write(ROOT/'status.json',dict(phase=name,status='running',log=str(log),pid=os.getpid(),updated=stamp()))
    record=dict(phase=name,argv=cmd,shell=shlex.join(cmd),cwd=str(cwd),log=str(log),start=stamp(),
                environment={k:env.get(k) for k in ['CUDA_VISIBLE_DEVICES','CUDA_LAUNCH_BLOCKING','NCCL_P2P_DISABLE','NCCL_IB_DISABLE','PYTHONHASHSEED']})
    print('PHASE',name,log,flush=True)
    with log.open('ab',buffering=0) as out:
        process=subprocess.run(cmd,cwd=cwd,env=env,stdout=out,stderr=subprocess.STDOUT)
    record.update(exit=process.returncode,end=stamp())
    with (ROOT/'commands.jsonl').open('a') as f:f.write(json.dumps(record)+'\n')
    if process.returncode:raise RuntimeError(f'{name} failed with exit {process.returncode}; log={log}')
def seal_stage(b):
    stage=ROOT/'ckpt'/f'block_{b}'
    check=read(stage/'checkpoint_reload_validation.json')
    assert check['saved_tensors_reload_exactly'] and check['two_independent_reloads_logits_exactly_equal']
    config=read(stage/'launch_config.json');a=config['experiment_args']
    assert a['attention_budget_share']==.4 and a['score_mode']=='lora_delta_taylor'
    assert config['training_arguments']['learning_rate']==0.0001
    assert config['original_train_length']==config['actual_train_length']
    hashes={p.name:digest(p) for p in stage.iterdir() if p.is_file() and p.name!='stage_manifest.json'}
    write(stage/'stage_manifest.json',dict(block=b,files=hashes,complete=True,
          checkpoint_selection='minimum validation response CE',resume_semantics='model-only stage restart'))
def make_eval_layout():
    from safetensors import safe_open
    from safetensors.torch import save_file
    layout=ROOT/'evaluation_checkpoints';layout.mkdir(exist_ok=True)
    for name in ['config.json','generation_config.json','special_tokens_map.json','tokenizer.json','tokenizer_config.json']:
        shutil.copy2(ROOT/'ckpt/block_4'/name,layout/name)
    final=layout/'block_4'
    if not final.exists():final.symlink_to(ROOT/'ckpt/block_4',target_is_directory=True)
    for b in range(1,4):
        dest=layout/f'block_{b}';dest.mkdir(exist_ok=True)
        with safe_open(str(ROOT/'ckpt'/f'block_{b}'/'model.safetensors'),framework='pt',device='cpu') as f:
            values={k:f.get_tensor(k) for k in f.keys() if '.modules_to_save.default.' in k}
            assert len(values)==2
            save_file(values,str(dest/'modules_to_save.safetensors'))
        write(dest/'subset_manifest.json',dict(source=str(ROOT/'ckpt'/f'block_{b}'/'model.safetensors'),
              source_sha256=read(ROOT/'ckpt'/f'block_{b}'/'stage_manifest.json')['files']['model.safetensors'],
              subset_sha256=digest(dest/'modules_to_save.safetensors')))

def persistent_stage(b):
    parent=ROOT/'persistent_stages'
    return parent/f'block_{b}'

def persist_stage(b):
    stage=ROOT/'ckpt'/f'block_{b}'
    source=stage.resolve()
    destination=persistent_stage(b)
    if source==destination.resolve() and destination.exists():return
    assert source.is_relative_to(pathlib.Path('/dev/shm/delta_books_delta_taylor_budget10_a40_m60_r100_lr1e4_seed42_20261020_26412'))
    assert (source/'stage_manifest.json').is_file()
    destination.parent.mkdir(parents=True,exist_ok=True)
    partial=destination.with_name(destination.name+'_partial_'+stamp())
    assert not destination.exists() and not partial.exists()
    shutil.copytree(source,partial,symlinks=False)
    copied=[]
    for original in source.rglob('*'):
        if original.is_file():
            relative=original.relative_to(source)
            saved=partial/relative
            assert saved.is_file() and not saved.is_symlink()
            h=digest(original);assert digest(saved)==h,str(relative)
            copied.append(dict(file=str(relative),sha256=h,bytes=saved.stat().st_size))
    partial.rename(destination)
    temporary_link=stage.with_name(stage.name+'_persistent_link')
    assert stage.is_symlink() and not temporary_link.exists()
    temporary_link.symlink_to(destination,target_is_directory=True)
    os.replace(temporary_link,stage)
    assert stage.resolve()==destination.resolve() and '/dev/shm' not in str(stage.resolve())
    write(ROOT/'audit'/f'persistence_block{b}.json',dict(source=str(source),destination=str(destination),
          all_files_sha256_equal=True,files=copied,final_checkpoint_uses_regular_persistent_files=True))
    assert source.resolve().is_relative_to(pathlib.Path('/dev/shm/delta_books_delta_taylor_budget10_a40_m60_r100_lr1e4_seed42_20261020_26412'))
    shutil.rmtree(source)

